# The public origin lives in src/config/site.ts (https://sethstearns.dev).
# Phase 2 only. Ignored while features.contactApi is false in that file.
VITE_CONTACT_API_URL=

# Public Turnstile site key. src/config/site.ts already defaults to the production widget.
# For a local widget that always passes, set the test site key 1x00000000000000000000AA
# and set TURNSTILE_SECRET in api/local.settings.json to the matching test secret.
# Do not put a test site key in the Azure build.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAForbSDVPuig8KiS
