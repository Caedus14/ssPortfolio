{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/images/*",
      "*.css",
      "*.js",
      "*.map",
      "*.png",
      "*.svg",
      "*.ico",
      "*.webp",
      "*.woff2",
      "*.pdf",
      "/resume.pdf",
      "/robots.txt",
      "/site.webmanifest",
      "/favicon.svg",
      "/og.png"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".pdf": "application/pdf"
  }
}
